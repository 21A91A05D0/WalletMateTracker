<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Expense / Income Toggle -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTransactionType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            app:singleSelection="true"
            app:checkedButton="@id/btnExpense">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExpense"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Expense"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIncome"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Income"
                app:cornerRadius="20dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- CATEGORY -->
        <TextView
            android:text="Category"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/purple_light"
            app:cardBackgroundColor="@color/field_bg">

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- AMOUNT -->
        <TextView
            android:text="Amount"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/purple_light"
            app:cardBackgroundColor="@color/field_bg">

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="₹ 0.00"
                android:inputType="numberDecimal"
                android:background="@null"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- CURRENCY -->
        <TextView
            android:text="Currency"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/purple_light"
            app:cardBackgroundColor="@color/field_bg">

            <Spinner
                android:id="@+id/spinnerCurrency"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- DESCRIPTION -->
        <TextView
            android:text="Description"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/purple_light"
            app:cardBackgroundColor="@color/field_bg">

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top|start"
                android:hint="Add note (optional)"
                android:background="@null"
                android:padding="12dp"
                android:inputType="textMultiLine"
                android:textSize="15sp" />
        </com.google.android.material.card.MaterialCardView>


        <!-- PAYMENT METHOD -->
        <TextView
            android:text="Payment Method"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/purple_light"
            app:cardBackgroundColor="@color/field_bg">

            <Spinner
                android:id="@+id/spinnerPayment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- DATE -->
        <TextView
            android:text="Date"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/purple_light"
            app:cardBackgroundColor="@color/field_bg">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="select date"
                android:textColor="@color/purple_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ATTACH RECEIPT -->
        <TextView
            android:text="Attach Receipt"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAttachReceipt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Upload image"
            app:cornerRadius="14dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginBottom="24dp" />

        <ImageView
            android:id="@+id/imgReceiptPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <!-- ADD BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Add"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            android:backgroundTint="@color/purple_primary" />

    </LinearLayout>
</ScrollView>
