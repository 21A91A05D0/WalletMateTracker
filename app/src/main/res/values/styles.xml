<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextLabel">
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="InputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="SpinnerField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ClickableField">
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/purple_primary</item>
    </style>

    <style name="OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton"/>


